VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional override for confirmation-email redirect (must be in Supabase → Redirect URLs).
# Web dev (default if unset): http://localhost:5173/auth/callback
# Android app (default if unset on device): com.arch.surf://auth/callback
# VITE_AUTH_REDIRECT_URL=com.arch.surf://auth/callback
# VITE_DEV_FAST_WAVE=true

# Telegram Login Widget Configuration
VITE_TELEGRAM_BOT_NAME=vMebachabot


# Set in Supabase Dashboard → Edge Functions → Secrets (never commit):
# OPENROUTER_API_KEY=sk-or-v1-...
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ...

