{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "QUM Design System",
    "version": "1.0.0",
    "theme": "Indie Festival",
    "description": "Film-festival grid: mono schedule, spotlight orange. Accent reserved for ቁም, Halt Bar, and one primary action per screen."
  },
  "color": {
    "bg": { "value": "#0E0D0A", "type": "color", "description": "Page foundation" },
    "bg-elevated": { "value": "#14120E", "type": "color" },
    "surface": { "value": "#161410", "type": "color", "description": "Cards, inputs, panels" },
    "surface-raised": { "value": "#1C1A14", "type": "color" },
    "primary": { "value": "#E8E4DB", "type": "color", "description": "Headlines and core text" },
    "primary-dim": { "value": "#B6B0A2", "type": "color" },
    "secondary": { "value": "#857F72", "type": "color", "description": "Borders, captions, metadata" },
    "secondary-faint": { "value": "#5B5648", "type": "color" },
    "accent": { "value": "#FF6B1A", "type": "color", "description": "Tertiary — sole interaction driver" },
    "accent-pressed": { "value": "#C8480B", "type": "color" },
    "on-accent": { "value": "#0E0D0A", "type": "color" },
    "line-1": { "value": "rgba(232, 228, 219, 0.08)", "type": "color" },
    "line-2": { "value": "rgba(232, 228, 219, 0.14)", "type": "color" },
    "line-3": { "value": "rgba(232, 228, 219, 0.22)", "type": "color" },
    "semantic": {
      "success": { "value": "#B8D4B0", "type": "color" },
      "warning": { "value": "#D4C4A0", "type": "color" },
      "error": { "value": "#D4A8A0", "type": "color" },
      "info": { "value": "#A8B8D4", "type": "color" }
    },
    "light-mode": {
      "bg": { "value": "#F5F3EE", "type": "color" },
      "surface": { "value": "#FFFFFF", "type": "color" },
      "primary": { "value": "#0E0D0A", "type": "color" },
      "secondary": { "value": "#5B5648", "type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "mono": { "value": "'IBM Plex Mono', ui-monospace, monospace", "type": "fontFamily" },
      "amharic": { "value": "'Bela Bereka', 'Noto Sans Ethiopic', serif", "type": "fontFamily" }
    },
    "scale": {
      "display-xl": { "value": { "fontSize": "4.5rem", "lineHeight": "1.05", "fontWeight": 700, "letterSpacing": "-0.03em" }, "type": "typography" },
      "display": { "value": { "fontSize": "3.5rem", "lineHeight": "1.1", "fontWeight": 700, "letterSpacing": "-0.02em" }, "type": "typography" },
      "h1": { "value": { "fontSize": "1.85rem", "lineHeight": "1.2", "fontWeight": 600 }, "type": "typography" },
      "h2": { "value": { "fontSize": "1.35rem", "lineHeight": "1.25", "fontWeight": 600 }, "type": "typography" },
      "h3": { "value": { "fontSize": "1.1rem", "lineHeight": "1.3", "fontWeight": 600 }, "type": "typography" },
      "body-lg": { "value": { "fontSize": "1.05rem", "lineHeight": "1.55", "fontWeight": 400 }, "type": "typography" },
      "body": { "value": { "fontSize": "0.92rem", "lineHeight": "1.55", "fontWeight": 400 }, "type": "typography" },
      "caption": { "value": { "fontSize": "0.78rem", "lineHeight": "1.45", "fontWeight": 400 }, "type": "typography" },
      "label": { "value": { "fontSize": "0.7rem", "lineHeight": "1.4", "fontWeight": 500, "letterSpacing": "0.12em", "textTransform": "uppercase" }, "type": "typography" }
    }
  },
  "space": {
    "unit": { "value": "8px", "type": "dimension", "description": "Base grid unit" },
    "0": { "value": "0", "type": "dimension" },
    "1": { "value": "8px", "type": "dimension" },
    "2": { "value": "16px", "type": "dimension" },
    "3": { "value": "24px", "type": "dimension" },
    "4": { "value": "32px", "type": "dimension" },
    "5": { "value": "40px", "type": "dimension" },
    "6": { "value": "48px", "type": "dimension" },
    "8": { "value": "64px", "type": "dimension" },
    "10": { "value": "80px", "type": "dimension" },
    "12": { "value": "96px", "type": "dimension" }
  },
  "radius": {
    "sm": { "value": "0px", "type": "borderRadius" },
    "md": { "value": "2px", "type": "borderRadius" },
    "lg": { "value": "4px", "type": "borderRadius" }
  },
  "grid": {
    "columns": { "value": 12, "type": "number" },
    "gutter": { "value": "24px", "type": "dimension" },
    "margin": { "value": "clamp(20px, 4vw, 56px)", "type": "dimension" },
    "maxWidth": { "value": "1280px", "type": "dimension" }
  },
  "motion": {
    "duration-fast": { "value": "120ms", "type": "duration" },
    "duration-base": { "value": "200ms", "type": "duration" },
    "duration-slow": { "value": "400ms", "type": "duration" },
    "ease-standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier" }
  },
  "identity": {
    "amharicGlyph": { "value": "ቁም", "type": "string" },
    "tagline": { "value": "Stand. Halt.", "type": "string" },
    "haltBarRatio": { "value": 0.2, "type": "number", "description": "Bar width = height × ratio, min 3px" }
  }
}
